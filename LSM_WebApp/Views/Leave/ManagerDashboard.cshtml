@model IEnumerable<LSM_WebApp.Models.LeaveRequest>
@{
    ViewBag.Title = "Manager Approval Panel";
}



<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-md-12">
            <div class="card bg-dark text-white shadow">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <h2 class="m-0"><i class="glyphicon glyphicon-check"></i> Manager Approval Panel</h2>
                    <span class="badge badge-pill badge-light">Admin Access</span>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-4 shadow-sm">
        <div class="card-body bg-light">
            @using (Html.BeginForm("ManagerDashboard", "Leave", FormMethod.Get, new { @class = "form-inline" }))
            {
                <div class="form-group mr-3">
                    <label class="mr-2"><strong>Leave Type:</strong></label>
                    <select name="type" class="form-control">
                        <option value="">All Types</option>
                        <option value="Sick">Sick</option>
                        <option value="Casual">Casual</option>
                        <option value="Earned">Earned</option>
                    </select>
                </div>
                <div class="form-group mr-3">
                    <label class="mr-2"><strong>Status:</strong></label>
                    <select name="status" class="form-control">
                        <option value="">All Status</option>
                        <option value="Pending">Pending</option>
                        <option value="Approved">Approved</option>
                        <option value="Rejected">Rejected</option>
                    </select>
                </div>
                <button type="submit" class="btn btn-primary">
                    <i class="glyphicon glyphicon-filter"></i> Apply Filters
                </button>
                <a href="@Url.Action("ManagerDashboard")" class="btn btn-default ml-2">Reset</a>
            }
        </div>
    </div>

    <div class="card shadow">
        <div class="card-body p-0">
            <table class="table table-hover table-striped mb-0">
                <thead class="thead-dark">
                    <tr>
                        <th>Emp ID</th>
                        <th>Leave Type</th>
                        <th>Dates (Start - End)</th>
                        <th>Status</th>
                        <th width="350">Action / Manager Comment</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var statusColor = item.Status == "Approved" ? "text-success" :
                                         item.Status == "Rejected" ? "text-danger" : "text-warning";

                        <tr>
                            <td><strong>#@item.UserID</strong></td>
                            <td><span class="label label-info">@item.LeaveType</span></td>
                            <td>
                                @item.StartDate.ToString("dd MMM yyyy")
                                <span class="text-muted">to</span>
                                @item.EndDate.ToString("dd MMM yyyy")
                            </td>
                            <td>
                                <strong class="@statusColor">@item.Status</strong>
                            </td>
                            <td>
                                @if (item.Status == "Pending")
                                {
                                    using (Html.BeginForm("ProcessLeave", "Leave", FormMethod.Post, new { @class = "form-inline" }))
                                    {
                                        <input type="hidden" name="reqId" value="@item.RequestID" />
                                        <input type="text" name="comment" placeholder="Optional comment..." class="form-control input-sm mr-2" style="width:180px" />

                                        <button name="status" value="Approved" class="btn btn-success btn-sm shadow-sm" onclick="return confirm('Approve this leave?')">
                                            <i class="glyphicon glyphicon-ok"></i>
                                        </button>
                                        <button name="status" value="Rejected" class="btn btn-danger btn-sm shadow-sm" onclick="return confirm('Reject this leave?')">
                                            <i class="glyphicon glyphicon-remove"></i>
                                        </button>
                                    }
                                }
                                else
                                {
                                    <i class="text-muted small">@item.ManagerComment</i>
                                }
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">No leave requests found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .card {
        border-radius: 8px;
        overflow: hidden;
    }

    .table thead th {
        vertical-align: middle;
        border-bottom: none;
    }

    .btn-sm {
        padding: 5px 10px;
        margin-left: 2px;
    }

    .label {
        font-size: 90%;
    }
</style>