@model IEnumerable<LSM_WebApp.Models.LeaveRequest>
@{
    ViewBag.Title = "Manager Approval Panel";
}

<div class="container mt-4">
    <div class="row mb-3">
        <div class="col-md-12 text-left">
            <a href="@Url.Action("MyRequests", "Leave")" class="btn btn-info shadow-sm">
                <i class="glyphicon glyphicon-arrow-left"></i> Back to Apply Page
            </a>
        </div>
    </div>

    <div class="card shadow border-dark">
        <div class="card-header bg-dark text-white text-center">
            <h3 class="mb-0">Manager Dashboard [cite: 31]</h3>
        </div>

        <div class="card-body p-0">
            <table class="table table-bordered mb-0">
                <thead class="thead-dark">
                    <tr>
                        <th>Emp ID</th>
                        <th>Type</th>
                        <th>Dates</th>
                        <th>Status</th>
                        <th>Reason</th>
                        <th>Action & Comment </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>#@item.UserID</td>
                            <td>@item.LeaveType</td>
                            <td>@item.StartDate.ToShortDateString() - @item.EndDate.ToShortDateString()</td>
                            <td><strong>@item.Status</strong></td>
                            <td>
                                @if (item.Status == "Pending")
                                {
                                    using (Html.BeginForm("ProcessLeave", "Leave", FormMethod.Post, new { @class = "form-inline" }))
                                    {
                                        <input type="hidden" name="reqId" value="@item.RequestID" />
                                        <input type="text" name="comment" placeholder="Optional comment" class="form-control input-sm mx-1" style="width:180px" />
                                        <button name="status" value="Approved" class="btn btn-success btn-sm">Approve</button>
                                        <button name="status" value="Rejected" class="btn btn-danger btn-sm">Reject</button>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted">Note: @item.ManagerComment</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>