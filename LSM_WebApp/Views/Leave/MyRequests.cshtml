@model IEnumerable<LSM_WebApp.Models.LeaveRequest>
@{
    ViewBag.Title = "Employee Leave Portal";
}

<div class="container mt-4">
    <div class="row mb-3">
        <div class="col-md-12 text-right">
            <a href="@Url.Action("ManagerDashboard", "Leave")" class="btn btn-warning shadow-sm">
                <i class="glyphicon glyphicon-user"></i> Go to Manager Dashboard
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-md-4">
            <div class="card shadow border-primary">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Apply for Leave</h4>
                </div>
                <div class="card-body">
                    @using (Html.BeginForm("Apply", "Leave", FormMethod.Post))
                    {
                        <div class="form-group">
                            <label>Leave Type</label>
                            <select name="LeaveType" class="form-control" required>
                                <option value="Sick">Sick (Quota: 12)</option>
                                <option value="Casual">Casual (Quota: 12)</option>
                                <option value="Earned">Earned (Quota: 20)</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Start Date</label>
                            <input type="date" name="StartDate" class="form-control" required />
                        </div>
                        <div class="form-group">
                            <label>End Date</label>
                            <input type="date" name="EndDate" class="form-control" required />
                        </div>
                        <div class="form-group">
                            <label>Reason</label>
                            <textarea name="Reason" class="form-control" rows="3" required placeholder="Reason for leave..."></textarea>
                        </div>
                        <button type="submit" class="btn btn-primary btn-block btn-lg">Submit Request</button>
                    }

                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger mt-3 small">
                            <i class="glyphicon glyphicon-exclamation-sign"></i> @TempData["Error"]
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card shadow border-info">
                <div class="card-header bg-info text-white">
                    <h4 class="mb-0">My Leave History</h4>
                </div>
                <div class="card-body p-0">
                    <table class="table table-hover mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th>Type</th>
                                <th>Dates</th>
                                <th>Status</th>
                                <th>Reason</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                var badge = item.Status == "Approved" ? "label-success" :
                                            item.Status == "Rejected" ? "label-danger" : "label-warning";
                                <tr>
                                    <td><strong>@item.LeaveType</strong></td>
                                    <td>@item.StartDate.ToString("dd MMM") - @item.EndDate.ToString("dd MMM yyyy")</td>
                                    <td><span class="label @badge">@item.Status</span></td>
                                    <td><small class="text-muted">@(item.Reason ?? "-")</small></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card {
        border-radius: 10px;
        margin-bottom: 20px;
    }

    .label {
        padding: 5px 10px;
        font-size: 12px;
    }
    .form-group label {
        font-weight: bold;
    }
</style>